{
    "name": "competence-graph-nodejs",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "anchor": "node --env-file-if-exists=../../../.env ./src/adapters/anchor/evm/run.js",
        "migrate": "node --env-file-if-exists=../../../.env ./src/adapters/db/postgres/migrate.js",
        "start": "node --env-file-if-exists=../../../.env ./src/server.js",
        "dev": "node --watch --env-file-if-exists=../../../.env ./src/server.js",
        "deploy": "neon functions deploy api --src ./src/app.js"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.1",
        "@openzeppelin/merkle-tree": "^1.0.8",
        "hono": "^4.13.5",
        "pg": "^8.23.0",
        "viem": "^2.56.3"
    }
}
